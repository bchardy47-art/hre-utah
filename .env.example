# Resend API key — get one free at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The "from" email address for contact form submissions.
# Must be a verified domain in Resend, or use Resend's shared domain:
# onboarding@resend.dev (for testing only)
RESEND_FROM_EMAIL=contact@hre-utah.com

# Where contact form submissions are forwarded
CONTACT_TO_EMAIL=brian@hre-utah.com

# Google Analytics 4 measurement ID (public identifier, safe to commit).
# Also set in Vercel → Project Settings → Environment Variables.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional standalone Hardy Homes site root used by HRE gateway CTAs
NEXT_PUBLIC_HARDY_HOMES_URL=https://buildahardyhome.com
