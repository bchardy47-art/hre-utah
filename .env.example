# =============================================================================
# PUBLIC SITE (existing)
# =============================================================================

# Resend API key — get one free at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The "from" email address for contact form submissions.
# Must be a verified domain in Resend, or use Resend's shared domain:
# onboarding@resend.dev (for testing only)
RESEND_FROM_EMAIL=contact@hre-utah.com

# Where contact form submissions are forwarded
CONTACT_TO_EMAIL=Hardyhomesutah@gmail.com

# Google Analytics 4 measurement ID (public identifier, safe to commit).
# Also set in Vercel → Project Settings → Environment Variables.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# =============================================================================
# TRADE PARTNER PORTAL
#
# The public marketing pages build and run without any of these. The portal
# routes fail loudly at request time if a required one is missing.
# Full documentation: docs/TRADE_PARTNER_PORTAL.md
# =============================================================================

# --- Required ----------------------------------------------------------------

# PostgreSQL connection string. Works with any Postgres — Neon, Supabase, RDS,
# or a local instance. On Vercel, add this in Project Settings → Environment
# Variables for Production, Preview and Development.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Session signing secret. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
PORTAL_SESSION_SECRET=

# The portal's own origin. Used to build invitation links and email buttons.
# Must match the deployed domain or invitation links will point at the wrong host.
NEXT_PUBLIC_APP_URL=https://hre-utah.com

# --- Cloudflare R2 (private document storage) --------------------------------
# Create a bucket with PUBLIC ACCESS DISABLED, then an R2 API token scoped to it.
# Cloudflare dashboard → R2 → Manage R2 API Tokens.
#
# REQUIRED: the bucket also needs a CORS policy, because the browser uploads
# directly to R2. Without it every upload fails with an opaque "Failed to fetch"
# and nothing appears in the server logs. See the CORS section in
# docs/TRADE_PARTNER_PORTAL.md for the exact policy JSON.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hardy-homes-trade-partners
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Portal email -------------------------------------------------------------
# Both fall back to the public-site values above if unset.

# From address for portal notifications.
PORTAL_FROM_EMAIL=trade-partners@hre-utah.com
# Where administrator notifications and the action queue digest are sent.
PORTAL_ADMIN_EMAIL=Hardyhomesutah@gmail.com

# --- Scheduled expiration sweep ----------------------------------------------
# Vercel sends this as a bearer token on cron requests. Without it, the cron
# endpoint rejects every unauthenticated call — set it before relying on
# automatic expiration reminders.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- Optional tuning ----------------------------------------------------------

# Invitation link lifetime in days. Default 14.
PORTAL_INVITE_TTL_DAYS=14
# Session lifetime in hours. Default 12.
PORTAL_SESSION_TTL_HOURS=12
# Maximum upload size in bytes. Default 15 MB.
PORTAL_MAX_UPLOAD_BYTES=15728640
# Database pool size per serverless instance. Default 5.
PORTAL_DB_POOL_MAX=5

# --- Seeding (local and first deploy only) ------------------------------------
# Used once by `npm run portal:seed` to create the first administrator.
# Remove these after the account exists.
PORTAL_SEED_ADMIN_EMAIL=
PORTAL_SEED_ADMIN_PASSWORD=
PORTAL_SEED_ADMIN_NAME=Hardy Homes Administrator

# Safety latch. The demo trade partner fixtures refuse to run when
# NODE_ENV=production unless this is explicitly set to true. Leave it unset.
PORTAL_ALLOW_SEED=


# =============================================================================
# FIREBASE (feat/trade-partner-portal-firebase branch)
#
# Not used by the Postgres implementation. See docs/FIREBASE_MIGRATION.md.
# =============================================================================

# --- Client-safe. Public by design: the API key identifies the project, it does
# --- not authorise anything. Security Rules + server checks are the control.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to "true" only for local emulator development.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=

# --- Server-only. NEVER expose these to the browser; the service account
# --- bypasses every Security Rule.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM. Vercel stores newlines as literal \n — the code normalises
# that, so paste it exactly as downloaded and do not hand-escape it.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
